(1)   32/  C1D2F6 : 41E8 0003               lea     3(a0),a0				; Move to filename string parameter
(1)   33/  C1D2FA :                         ; Set filename to ASCII of game's NGH and append extension
(1)   34/  C1D2FA : 3038 0108               move.w  HEADER_NGH,d0
(1)   35/  C1D2FE : 7E03                    moveq.l #4-1,d7
