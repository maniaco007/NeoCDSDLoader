(1)   30/  C1D332 : 4228 0002               clr.b   2(a0)                   ; Force overwrite if file exists
(1)   31/  C1D336 :                     
(1)   32/  C1D336 : 41E8 0003               lea     3(a0),a0				; Move to filename string parameter
(1)   33/  C1D33A :                         ; Set filename to ASCII of game's NGH and append extension
(1)   34/  C1D33A : 3038 0108               move.w  HEADER_NGH,d0
(1)   35/  C1D33E : 7E03                    moveq.l #4-1,d7
